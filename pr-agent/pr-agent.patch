+    def _sync_key_issue_threads(self, state_result) -> None:
+        """Resolve the inline threads of findings this review reconciled as fixed, and reopen the
+        resolved threads of findings it reported again."""
+        if not self.git_provider.supports_thread_resolution() or not state_result.state["last_run"]["complete"]:
+            return
+        head_sha = self._review_head_sha()
+        # Every retained resolved finding too, so a thread whose resolution failed on an earlier run is retried.
+        fixed_ids = set(state_result.resolved_ids) | {finding["finding_id"]
+                                                      for finding in state_result.state.get("findings", [])
+                                                      if finding.get("state") == "RESOLVED"}
+        reported_ids = getattr(self, "_reported_finding_ids", set())
+        if not fixed_ids and not reported_ids:
+            return
+        try:
+            threads = list(self.git_provider.iter_key_issue_threads())
+        except Exception as e:
+            get_logger().warning(f"Could not list key-issue threads after the review, error: {e}")
+            return
